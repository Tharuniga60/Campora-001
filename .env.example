# ─────────────────────────────────────────────────────────────────────────────
# CampusLoop / Campora — real deployment settings.
# Copy to .env (never commit .env) and fill in. The server refuses to start
# if anything required is missing, and tells you exactly what.
# ─────────────────────────────────────────────────────────────────────────────

# 0 = real deployment (no demo data, OTP by SMS). 1 = demo mode with sample personas.
DEMO=0
NODE_ENV=production
PORT=3000

# Database file. Use a NEW file for the real campus (the demo data lives in data/db.json).
DB_FILE=data/campus.json

# Secret that encrypts phone numbers and emails at rest. 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe: losing it makes stored phone numbers/emails unreadable.
DATA_KEY=

# ── Your campus ──────────────────────────────────────────────────────────────
CAMPUS_NAME=
CAMPUS_SHORT=
# Official email domains allowed to sign up (comma separated)
CAMPUS_DOMAINS=yourcollege.edu.in,staff.yourcollege.edu.in
# Regex for college ID numbers (default: 2–4 letters + 4–8 digits, e.g. CS21045)
COLLEGE_ID_PATTERN=^[A-Za-z]{2,4}[0-9]{4,8}$
SECURITY_PHONE=+91 00000 00000
SECURITY_NAME=Campus Security Control Room

# 10-digit mobile numbers that become admins when they sign up (comma separated).
# Add/remove a number and restart to grant/revoke admin access.
ADMIN_PHONES=

# ── OTP by SMS ───────────────────────────────────────────────────────────────
# msg91 (recommended in India: DLT-approved OTP template) | twilio | console (local testing only)
SMS_PROVIDER=msg91

# MSG91: dashboard → Authkey; OTP template (DLT approved) must contain ##OTP##
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Twilio: console.twilio.com → Account SID / Auth Token; a sender number or Messaging Service
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ── Wallet top-ups (Razorpay) ────────────────────────────────────────────────
# dashboard.razorpay.com → Settings → API Keys. Start with rzp_test_ keys; switch to rzp_live_ after KYC.
# Leave both empty to switch top-ups off (free items, lost & found, chat still work).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings → Webhooks → URL https://YOUR-DOMAIN/api/payments/razorpay/webhook,
# events payment.captured + order.paid, and the same secret here.
RAZORPAY_WEBHOOK_SECRET=

# ── Hosting ──────────────────────────────────────────────────────────────────
# 1 when running behind a reverse proxy / platform (Render, Railway, Nginx) so rate limits see real client IPs
TRUST_PROXY=1
